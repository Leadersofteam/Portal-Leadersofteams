# Konfiguracja lokalnego developmentu (patrz src/shared/config.ts).
NODE_ENV=development
PORT=3001
DATABASE_URL=mysql://portal:portal@localhost:3306/portal
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=lot_sid
SESSION_TTL_SECONDS=604800
LOG_LEVEL=debug

# Publiczny adres frontendu (linki w e-mailach weryfikacji/resetu).
APP_BASE_URL=http://localhost:3000

# E-mail (D4) — OPCJONALNE. Puste = tryb no-op (0 zł, ADR-009): rejestracja
# działa bez wysyłki, weryfikacja/reset zwracają devToken poza produkcją.
# Podanie klucza Brevo (darmowy tier 300/dzień) WŁĄCZA realną wysyłkę.
BREVO_API_KEY=
MAIL_FROM=no-reply@leadersofteams.pl
MAIL_FROM_NAME=Leaders of Teams
