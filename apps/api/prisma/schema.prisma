// Schemat v2 (Sprint 1–2): tożsamość + outbox + marketplace.
// Kolejne moduły (ladder, groups, community…) dokładają swoje tabele
// w kolejnych migracjach — patrz docs/architecture/DATA-MODEL.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// identity
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum CompanyMemberRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyMemberships CompanyMember[]
  leaderProfile      LeaderProfile?
  createdOrders      Order[]

  @@map("users")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  // NIP opcjonalny — brak weryfikacji Firm na starcie (brief 3.4),
  // pole gotowe pod przyszłą weryfikację-odznakę.
  nip         String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CompanyMember[]
  orders  Order[]

  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

// ---------------------------------------------------------------------------
// marketplace — słownik branż, profile Liderów, zlecenia, oferty
// ---------------------------------------------------------------------------

model Industry {
  id   String @id @default(cuid())
  name String
  slug String @unique

  leaderProfiles LeaderProfile[]
  orders         Order[]

  @@map("industries")
}

model LeaderProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  industryId String
  headline   String
  bio        String?  @db.Text
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry       Industry        @relation(fields: [industryId], references: [id])
  portfolioItems PortfolioItem[]
  offers         Offer[]

  @@index([industryId, isVisible])
  @@map("leader_profiles")
}

model PortfolioItem {
  id              String   @id @default(cuid())
  leaderProfileId String
  title           String
  url             String?
  description     String?  @db.Text
  createdAt       DateTime @default(now())

  leaderProfile LeaderProfile @relation(fields: [leaderProfileId], references: [id], onDelete: Cascade)

  @@index([leaderProfileId])
  @@map("portfolio_items")
}

// Cykl życia (ADR-006): DRAFT → PUBLISHED → AWARDED → IN_PROGRESS →
// DELIVERED → CONFIRMED (+ CANCELLED, DISPUTED). Ocena (RATED) dojdzie
// w sprincie Drabinki jako osobna encja Review.
enum OrderStatus {
  DRAFT
  PUBLISHED
  AWARDED
  IN_PROGRESS
  DELIVERED
  CONFIRMED
  CANCELLED
  DISPUTED
}

model Order {
  id             String      @id @default(cuid())
  companyId      String
  createdById    String
  industryId     String
  title          String
  description    String      @db.Text
  budgetMin      Int
  budgetMax      Int
  minLevel       Int         @default(0)
  status         OrderStatus @default(DRAFT)
  publishedAt    DateTime?
  awardedOfferId String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company      Company  @relation(fields: [companyId], references: [id])
  createdBy    User     @relation(fields: [createdById], references: [id])
  industry     Industry @relation(fields: [industryId], references: [id])
  offers       Offer[]  @relation("orderOffers")
  awardedOffer Offer?   @relation("awardedOffer", fields: [awardedOfferId], references: [id])

  @@index([status, industryId, minLevel, publishedAt])
  @@index([companyId, status])
  @@fulltext([title, description])
  @@map("orders")
}

enum OfferStatus {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

model Offer {
  id              String      @id @default(cuid())
  orderId         String
  leaderProfileId String
  message         String      @db.Text
  proposedBudget  Int?
  proposedDays    Int?
  status          OfferStatus @default(SUBMITTED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  order         Order         @relation("orderOffers", fields: [orderId], references: [id], onDelete: Cascade)
  leaderProfile LeaderProfile @relation(fields: [leaderProfileId], references: [id])
  awardedFor    Order?        @relation("awardedOffer")

  @@unique([orderId, leaderProfileId])
  @@index([leaderProfileId, createdAt])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// infrastruktura domenowa
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Wzorzec outbox (ADR-007): zapis w tej samej transakcji co zmiana stanu;
// dispatcher w worker.ts publikuje do BullMQ i oznacza PUBLISHED.
model OutboxEvent {
  id          String       @id @default(cuid())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  @@index([status, createdAt])
  @@map("outbox_events")
}
