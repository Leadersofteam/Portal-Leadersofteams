// Schemat v2 (Sprint 1–2): tożsamość + outbox + marketplace.
// Kolejne moduły (ladder, groups, community…) dokładają swoje tabele
// w kolejnych migracjach — patrz docs/architecture/DATA-MODEL.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// identity
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum CompanyMemberRole {
  OWNER
  MEMBER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  role            UserRole  @default(USER)
  // RODO (D6): anonimizacja W MIEJSCU — konto usunięte, ledger zachowany.
  anonymizedAt    DateTime?
  // Weryfikacja adresu (D4, e-mail za flagą) — null = niezweryfikowany.
  emailVerifiedAt DateTime?
  // Awatar (moduł files) — SetNull: usunięcie pliku nie kasuje konta.
  avatarFileId    String?   @unique
  // Uchwyt @handle (moduł social) — do wzmianek i publicznego profilu.
  handle          String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Pierwsza mila (S10). To CZYSTY stan UI: gdzie użytkownik jest w kreatorze
  // i czy schował checklistę. ŻADNE z tych pól nie rodzi zdarzenia i nie ma
  // drogi do Drabinki — onboarding to mapa, nie nagroda (ADR-004).
  // Intencja trzymana jako String, nie enum: to pole wyłącznie prezentacyjne,
  // a każdy enum w MySQL to kolejny ALTER przy najmniejszej zmianie.
  onboardingStep        Int       @default(0)
  onboardingIntent      String?
  onboardingCompletedAt DateTime?
  checklistDismissedAt  DateTime?

  avatarFile    UploadedFile?  @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  uploadedFiles UploadedFile[] @relation("FileOwner")

  companyMemberships CompanyMember[]
  leaderProfile      LeaderProfile?
  createdOrders      Order[]
  createdInquiries   Inquiry[]
  inquiryMessages    InquiryMessage[]
  listingFavorites   ListingFavorite[]
  following          Follow[]            @relation("Follower")
  followers          Follow[]            @relation("Followed")
  activityItems      ActivityItem[]
  socialPosts        SocialPost[]        @relation("SocialAuthor")
  socialComments     SocialComment[]     @relation("SocialCommentAuthor")
  socialReactions    SocialReaction[]    @relation("SocialReactor")
  createdGroups      Group[]
  groupMemberships   GroupMembership[]
  posts              Post[]
  comments           Comment[]
  reactions          Reaction[]
  threads            Thread[]
  answers            Answer[]
  answerVotes        AnswerVote[]
  notifications      Notification[]
  verificationTokens VerificationToken[]
  bookmarks          Bookmark[]

  @@map("users")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Tokeny weryfikacji e-mail i resetu hasła (D4). Przechowujemy wyłącznie HASH
// tokena (surowy trafia tylko do e-maila); jednorazowy (usedAt) + wygasający.
model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  // NIP opcjonalny — brak weryfikacji Firm na starcie (brief 3.4).
  nip         String?
  // Znacznik POPRAWNOŚCI FORMALNEJ numeru (suma kontrolna mod 11), a NIE
  // potwierdzenie istnienia firmy w rejestrze. Trwały ślad zamiast liczenia
  // sumy przy każdym renderze — i miejsce, w którym kiedyś stanie data
  // weryfikacji w Białej Liście MF, gdy potwierdzimy limity darmowego API.
  nipVerifiedAt DateTime?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   CompanyMember[]
  orders    Order[]
  inquiries Inquiry[]

  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

// ---------------------------------------------------------------------------
// marketplace — słownik branż, profile Liderów, zlecenia, oferty
// ---------------------------------------------------------------------------

model Industry {
  id   String @id @default(cuid())
  name String
  slug String @unique

  leaderProfiles  LeaderProfile[]
  orders          Order[]
  groups          Group[]
  serviceListings ServiceListing[]

  @@map("industries")
}

model LeaderProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  industryId String
  headline   String
  bio        String?  @db.Text
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry        Industry         @relation(fields: [industryId], references: [id])
  portfolioItems  PortfolioItem[]
  offers          Offer[]
  serviceListings ServiceListing[]

  @@index([industryId, isVisible])
  @@map("leader_profiles")
}

model PortfolioItem {
  id              String   @id @default(cuid())
  leaderProfileId String
  title           String
  url             String?
  description     String?  @db.Text
  // Obraz pozycji portfolio (moduł files) — opcjonalny.
  imageFileId     String?
  createdAt       DateTime @default(now())

  leaderProfile LeaderProfile @relation(fields: [leaderProfileId], references: [id], onDelete: Cascade)
  imageFile     UploadedFile? @relation(fields: [imageFileId], references: [id], onDelete: SetNull)

  @@index([leaderProfileId])
  @@map("portfolio_items")
}

// ============================= files =============================
// Pliki użytkowników (awatary, portfolio, galerie usług). Na dysku leżą
// wyłącznie przetworzone warianty webp pod wygenerowaną nazwą (cuid) —
// oryginalna nazwa (po naprawie latin1→utf8) zostaje tylko w DB.

enum FileKind {
  AVATAR
  PORTFOLIO
  LISTING
  // Obrazy przy wpisach portalowych. Dopisane NA KOŃCU: MySQL trzyma ENUM jako
  // liczbę porządkową, więc wstawienie w środek po cichu przemapowałoby
  // istniejące pliki na sąsiednie rodzaje.
  SOCIAL
}

model UploadedFile {
  id           String   @id @default(cuid())
  ownerId      String
  kind         FileKind
  // Ścieżka względna wobec UPLOADS_DIR, bez wariantu: <yyyy-mm>/<cuid>
  storagePath  String
  originalName String
  mime         String
  size         Int
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  owner          User            @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarOfUser   User?           @relation("UserAvatar")
  portfolioItems PortfolioItem[]
  listingImages  ListingImage[]
  socialImages   SocialPostImage[]
  postImages     PostImage[]

  @@index([ownerId, kind])
  @@map("uploaded_files")
}

// Cykl życia (ADR-006): DRAFT → PUBLISHED → AWARDED → IN_PROGRESS →
// DELIVERED → CONFIRMED (+ CANCELLED, DISPUTED). Ocena (RATED) dojdzie
// w sprincie Drabinki jako osobna encja Review.
enum OrderStatus {
  DRAFT
  PUBLISHED
  AWARDED
  IN_PROGRESS
  DELIVERED
  CONFIRMED
  CANCELLED
  DISPUTED
}

model Order {
  id             String      @id @default(cuid())
  companyId      String
  createdById    String
  industryId     String
  title          String
  description    String      @db.Text
  budgetMin      Int
  budgetMax      Int
  minLevel       Int         @default(0)
  status         OrderStatus @default(DRAFT)
  publishedAt    DateTime?
  awardedOfferId String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company      Company  @relation(fields: [companyId], references: [id])
  createdBy    User     @relation(fields: [createdById], references: [id])
  industry     Industry @relation(fields: [industryId], references: [id])
  offers       Offer[]  @relation("orderOffers")
  awardedOffer Offer?   @relation("awardedOffer", fields: [awardedOfferId], references: [id])
  reviews      Review[]

  @@index([status, industryId, minLevel, publishedAt])
  @@index([companyId, status])
  @@fulltext([title, description])
  @@map("orders")
}

enum OfferStatus {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

model Offer {
  id              String      @id @default(cuid())
  orderId         String
  leaderProfileId String
  message         String      @db.Text
  proposedBudget  Int?
  proposedDays    Int?
  status          OfferStatus @default(SUBMITTED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  order         Order         @relation("orderOffers", fields: [orderId], references: [id], onDelete: Cascade)
  leaderProfile LeaderProfile @relation(fields: [leaderProfileId], references: [id])
  awardedFor    Order?        @relation("awardedOffer")

  @@unique([orderId, leaderProfileId])
  @@index([leaderProfileId, createdAt])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// infrastruktura domenowa
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Wzorzec outbox (ADR-007): zapis w tej samej transakcji co zmiana stanu;
// dispatcher w worker.ts publikuje do BullMQ i oznacza PUBLISHED.
model OutboxEvent {
  id          String       @id @default(cuid())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// marketplace — oceny (dwustronne, publikacja symultaniczna)
// ---------------------------------------------------------------------------

enum ReviewDirection {
  COMPANY_TO_LEADER
  LEADER_TO_COMPANY
}

// Ocena po CONFIRMED. Publikacja symultaniczna (anty-odwet, ADR-004/R-11):
// publishedAt ustawiane gdy obie strony oceniły albo po upływie okna 14 dni.
model Review {
  id                  String          @id @default(cuid())
  orderId             String
  direction           ReviewDirection
  authorUserId        String
  rating              Int
  comment             String?         @db.Text
  // denormalizacja pod statystyki profili (średnia ocen bez joinów)
  subjectLeaderUserId String?
  subjectCompanyId    String?
  createdAt           DateTime        @default(now())
  publishedAt         DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, direction])
  @@index([subjectLeaderUserId, publishedAt])
  @@index([subjectCompanyId, publishedAt])
  @@index([publishedAt, createdAt])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// ladder — append-only ledger punktowy (ADR-004)
// ---------------------------------------------------------------------------

// ZAMKNIĘTY enum źródeł punktów — anty-MLM w schemacie: nie istnieje typ
// za zaproszenie/rekrutację/aktywność. Zmiana wymaga migracji + rewizji ADR-004.
enum PointEventType {
  ORDER_COMPLETED_RATED
  ANSWER_ACCEPTED
  ANSWER_UPVOTED_QUALIFIED
  MENTORSHIP_SESSION_RATED
  ADJUSTMENT_MODERATION
}

enum PointEventStatus {
  PENDING
  CONFIRMED
  HOLD
  REVERSED
}

// Wpisy niemutowalne (poza statusem); korekta = nowy wpis z reversalOfId.
model PointEvent {
  id              String           @id @default(cuid())
  userId          String
  type            PointEventType
  points          Int
  weightApplied   Float            @default(1)
  // pełne pochodzenie + wyjaśnienie wag (transparentność "za co i ile")
  meta            Json
  sourceType      String
  sourceId        String
  grantedByUserId String?
  counterpartyId  String?
  status          PointEventStatus @default(PENDING)
  reversalOfId    String?
  rulesetVersion  String
  createdAt       DateTime         @default(now())
  confirmedAt     DateTime?

  // idempotencja naliczeń: redelivery zdarzenia nie duplikuje punktów
  @@unique([type, sourceId, userId])
  @@index([userId, status, createdAt])
  @@index([counterpartyId, userId, type, createdAt])
  @@index([status, createdAt])
  @@map("point_events")
}

model LevelDefinition {
  id                  String  @id @default(cuid())
  rulesetVersion      String
  level               Int
  name                String
  pointsRequired      Int
  // od L4: min. udział KAŻDEJ ze ścieżek (marketplace/community) w progu
  minPathSharePct     Int     @default(0)
  unlocksAppAccess    Boolean @default(false)
  unlocksTeamCreation Boolean @default(false)

  @@unique([rulesetVersion, level])
  @@map("level_definitions")
}

// Projekcja z ledgera — nigdy źródło prawdy, zawsze odtwarzalna.
model LadderState {
  userId            String   @id
  marketplacePoints Int      @default(0)
  communityPoints   Int      @default(0)
  totalPoints       Int      @default(0)
  level             Int      @default(0)
  isLeader          Boolean  @default(false)
  rulesetVersion    String
  updatedAt         DateTime @updatedAt

  @@index([level])
  @@map("ladder_states")
}

// Fakt awansu — poziom raz zdobyty nie wygasa (brief 6).
model LevelAchievement {
  id         String   @id @default(cuid())
  userId     String
  level      Int
  achievedAt DateTime @default(now())

  @@unique([userId, level])
  @@index([userId])
  @@map("level_achievements")
}

// ---------------------------------------------------------------------------
// antifraud + moderacja
// ---------------------------------------------------------------------------

model FraudSignal {
  id             String   @id @default(cuid())
  type           String
  userId         String
  counterpartyId String?
  payload        Json
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("fraud_signals")
}

enum ModerationCaseStatus {
  OPEN
  RESOLVED
}

model ModerationCase {
  id               String               @id @default(cuid())
  source           String
  status           ModerationCaseStatus @default(OPEN)
  subjectUserId    String?
  fraudSignalId    String?
  pointEventId     String?
  // Zgłoszenie użytkownika (D7): typ i id zgłoszonej encji + kto zgłosił.
  subjectType      String?
  subjectId        String?
  reportedByUserId String?
  note             String?              @db.Text
  resolution       String?
  resolvedById     String?
  createdAt        DateTime             @default(now())
  resolvedAt       DateTime?

  @@index([status, createdAt])
  @@index([reportedByUserId, subjectType, subjectId])
  @@map("moderation_cases")
}

// ---------------------------------------------------------------------------
// groups — grupy branżowe „jak Facebook" (ADR-010 dec. 1)
//
// GRANICA ANTY-MLM (ADR-004/010 dec. 4): żadna aktywność w groups nie generuje
// punktów. Zdarzenia groups.* NIE są konsumowane przez ladder (test
// subscriptions.test.ts). Posty/komentarze/reakcje/członkostwo = 0 pkt.
// ---------------------------------------------------------------------------

enum GroupType {
  OPEN
  MODERATED
}

enum GroupMemberRole {
  MEMBER
  MODERATOR
}

enum GroupMemberStatus {
  ACTIVE
  PENDING
  BANNED
}

model Group {
  id          String    @id @default(cuid())
  // Grupa per branża (słownik Industry) lub przekrojowa (industryId = null).
  industryId  String?
  name        String
  description String?   @db.Text
  type        GroupType @default(OPEN)
  createdById String?
  // Grupy systemowe zakłada platforma (seed) — kuratorowana lista sektorów.
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  industry    Industry?         @relation(fields: [industryId], references: [id])
  createdBy   User?             @relation(fields: [createdById], references: [id])
  memberships GroupMembership[]
  posts       Post[]
  threads     Thread[]

  @@index([industryId])
  @@index([createdAt])
  @@map("groups")
}

model GroupMembership {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole   @default(MEMBER)
  status    GroupMemberStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, status])
  @@map("group_memberships")
}

enum PostType {
  DISCUSSION
  CASE_STUDY
  IDEA
}

enum PostModerationStatus {
  VISIBLE
  HIDDEN
}

model Post {
  id               String               @id @default(cuid())
  groupId          String
  authorUserId     String
  type             PostType             @default(DISCUSSION)
  title            String
  body             String               @db.Text
  // teamId pod fazę 2 (case studies w imieniu zespołu, ADR-010 dec. 3) —
  // FK celowo pominięty do czasu istnienia modułu teams.
  teamId           String?
  moderationStatus PostModerationStatus @default(VISIBLE)
  // Przypięcie przez moderatora grupy (S17). NAJWYŻEJ JEDEN post na grupę —
  // egzekwowane w domenie (przypięcie nowego odpina poprzedni w transakcji),
  // nie unikatem, bo unikat częściowy („tylko gdy NOT NULL") nie istnieje
  // w MySQL. Dwa przypięcia byłyby drugim feedem, a ADR-010 zabrania rankingu
  // treści: jeden pin to nawigacja („zacznij tutaj"), nie kolejność.
  pinnedAt         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorUserId], references: [id])
  comments  Comment[]
  reactions Reaction[]
  images    PostImage[]
  topics    PostTopic[]

  // Edycja/usunięcie własnych treści (moduł social, S4) — soft delete.
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([groupId, createdAt])
  @@index([groupId, pinnedAt])
  @@index([authorUserId])
  @@fulltext([title, body])
  @@map("posts")
}

model Comment {
  id           String   @id @default(cuid())
  postId       String
  authorUserId String
  // Wątkowanie 1 poziom (ADR-010): komentarz-odpowiedź wskazuje rodzica,
  // ale rodzic nie może mieć rodzica (walidacja w domenie).
  parentId     String?
  body         String   @db.Text
  createdAt    DateTime @default(now())

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorUserId], references: [id])
  parent  Comment?  @relation("commentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("commentThread")

  // Edycja/usunięcie własnych treści (moduł social, S4) — soft delete.
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@map("comments")
}

// Jeden typ reakcji „doceniam" (ADR-010: celowo bez palety emocji — to portal
// pracy). Reakcje NIE generują punktów (anty-MLM).
model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("reactions")
}

// ---------------------------------------------------------------------------
// community — Q&A / mentoring (ADR-010 dec. 1; brief 3.3) = DRUGA, PUNKTOWANA
// ścieżka awansu w Drabince.
//
// GRANICA ANTY-MLM (ADR-002 §5, ADR-004): community JAKO JEDYNY moduł poza
// marketplace ma krawędź zdarzeń do ladder — to jest ZAPROJEKTOWANE. Punkty
// płyną z uznania drugiego człowieka: zaakceptowana odpowiedź (autor pytania)
// i kwalifikowany upvote (inny Lider). Wątki są zakotwiczone w grupach
// branżowych (Thread.groupId), jak posty. Logika punktowa NIE żyje tutaj —
// mieszka wyłącznie w ladder (jedyny punkt audytu anty-MLM).
// ---------------------------------------------------------------------------

enum ThreadStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Thread {
  id               String       @id @default(cuid())
  groupId          String
  authorUserId     String
  title            String
  body             String       @db.Text
  status           ThreadStatus @default(OPEN)
  // Wskaźnik na zaakceptowaną odpowiedź (jedna na wątek — egzekwowane w domenie).
  acceptedAnswerId String?
  // Ukrycie przez moderatora (S12). Osobne od `status`: CLOSED to decyzja
  // autora o zamknięciu dyskusji, a to jest decyzja moderatora o zdjęciu treści.
  // Nullable i bez domyślnej wartości — migracja expand-only, rollback aplikacji
  // nie wymaga cofania schematu.
  hiddenAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author  User     @relation(fields: [authorUserId], references: [id])
  answers Answer[]

  @@index([groupId, createdAt])
  @@index([authorUserId])
  @@fulltext([title, body])
  @@map("threads")
}

model Answer {
  id           String   @id @default(cuid())
  threadId     String
  authorUserId String
  body         String   @db.Text
  isAccepted   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  thread Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorUserId], references: [id])
  votes  AnswerVote[]

  // Edycja/usunięcie własnych treści (moduł social, S4) — soft delete.
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([threadId, createdAt])
  @@index([authorUserId])
  @@map("answers")
}

// Upvote „doceniam odpowiedź". Unikat (answerId, userId) = idempotencja głosu
// i zakaz podwójnego głosowania. Punktuje dopiero po kwalifikacji w ladder.
model AnswerVote {
  id        String   @id @default(cuid())
  answerId  String
  userId    String
  createdAt DateTime @default(now())

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@index([userId])
  @@map("answer_votes")
}

// ---------------------------------------------------------------------------
// notifications — powiadomienia in-app (D1; ADR-007 dec. 3)
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  // Klucz idempotencji konsumenta (at-least-once): "{eventType}:{entityId}".
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// listings — Usługi Liderów (Fiverr-lite, ADR-006: ceny DEKLARATYWNE, zero
// przepływu pieniędzy; transakcja i punkty wyłącznie przez istniejący Order)
// ---------------------------------------------------------------------------

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum InquiryStatus {
  OPEN
  CONVERTED
  CLOSED
}

model ServiceListing {
  id              String        @id @default(cuid())
  leaderProfileId String
  industryId      String
  title           String
  slug            String        @unique
  description     String        @db.Text
  status          ListingStatus @default(DRAFT)
  // Denormalizowane min(packages.priceDeclared) — sortowanie po cenie z kursorem.
  priceFrom       Int           @default(0)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  leaderProfile LeaderProfile     @relation(fields: [leaderProfileId], references: [id], onDelete: Cascade)
  industry      Industry          @relation(fields: [industryId], references: [id])
  packages      ListingPackage[]
  images        ListingImage[]
  tags          ListingTagLink[]
  inquiries     Inquiry[]
  favorites     ListingFavorite[]

  @@index([status, industryId, publishedAt])
  @@index([leaderProfileId])
  @@fulltext([title, description])
  @@map("service_listings")
}

// Pakiet cenowy (1–3 na usługę). priceDeclared w PLN — DEKLARACJA, nie płatność.
model ListingPackage {
  id            String      @id @default(cuid())
  listingId     String
  tier          PackageTier
  name          String
  priceDeclared Int
  scope         String      @db.Text
  deliveryDays  Int

  listing ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, tier])
  @@map("listing_packages")
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String
  fileId    String
  position  Int    @default(0)

  listing ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  file    UploadedFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([listingId, fileId])
  @@index([listingId, position])
  @@map("listing_images")
}

// Tagi jako relacja (nie tekst w FULLTEXT — ft_min_word_len=3 zjadłby np. "HR").
model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  listings ListingTagLink[]

  @@map("tags")
}

model ListingTagLink {
  listingId String
  tagId     String

  listing ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tag     Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([listingId, tagId])
  @@index([tagId])
  @@map("listing_tag_links")
}

model ListingFavorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@map("listing_favorites")
}

// Zapytanie Firmy o usługę: wątek wiadomości; konwersja tworzy zwykły Order
// (istniejący cykl życia → punkty/recenzje bez zmian). Kontakt bez DM — ADR-010.
model Inquiry {
  id               String        @id @default(cuid())
  listingId        String
  companyId        String
  createdById      String
  status           InquiryStatus @default(OPEN)
  convertedOrderId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  listing   ServiceListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdById], references: [id])
  messages  InquiryMessage[]

  @@index([listingId, status])
  @@index([companyId, createdAt])
  @@map("inquiries")
}

model InquiryMessage {
  id        String   @id @default(cuid())
  inquiryId String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([inquiryId, createdAt])
  @@map("inquiry_messages")
}

// ---------------------------------------------------------------------------
// social — obserwowanie + chronologiczny feed (X-lite w duchu ADR-010:
// zero algorytmu, zero punktów, kursor + „Wczytaj więcej")
// ---------------------------------------------------------------------------

model Follow {
  followerId String
  followedId String
  createdAt  DateTime @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
  @@map("follows")
}

// UWAGA MySQL: ENUM jest składowany jako LICZBA PORZĄDKOWA, nie tekst. Nowe
// wartości dopisujemy WYŁĄCZNIE NA KOŃCU listy — wstawienie w środek po cichu
// przemapowałoby istniejące wiersze na sąsiednie wartości.
enum ActivityType {
  POST_PUBLISHED
  LISTING_PUBLISHED
  ANSWER_ACCEPTED
  LEVEL_ACHIEVED
  SOCIAL_POST_PUBLISHED
}

// Feed materializowany przez workera z ISTNIEJĄCYCH zdarzeń (bez fan-outu —
// NFR 10k/1 VPS). subjectId wskazuje encję źródłową (post/usługa/wątek).
model ActivityItem {
  id        String       @id @default(cuid())
  actorId   String
  type      ActivityType
  subjectId String
  // Zdenormalizowany kontekst do renderu feedu bez N+1 (tytuł, slug itp.).
  meta      Json?
  createdAt DateTime     @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([type, subjectId])
  @@index([actorId, createdAt])
  // Feed „Cała społeczność" sortuje po czasie BEZ filtra po aktorze — bez tego
  // indeksu byłby to pełny skan tabeli przy każdym wejściu gościa na /feed.
  @@index([createdAt])
  @@map("activity_items")
}

// Obrazy przy poście w grupie (S17). Ten sam wzorzec co SocialPostImage —
// dyskusja branżowa bez możliwości pokazania zrzutu czy schematu jest kaleka.
model PostImage {
  id       String @id @default(cuid())
  postId   String
  fileId   String
  position Int    @default(0)

  post Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  file UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([postId, fileId])
  @@index([postId, position])
  @@map("post_images")
}

// ---------------------------------------------------------------------------
// Tematy (#hashtagi) — S17
//
// WŁASNY model, a NIE współdzielenie `Tag` z modułu listings. Tag przy usłudze
// to deklaracja sprzedawcy o kategorii oferty; temat we wpisie to swobodne
// słowo w rozmowie. Zlanie ich w jedną tabelę oznaczałoby, że „popularne tagi"
// w katalogu usług zaczynają mieszać kategorie ofert z tematami dyskusji.
//
// WŁAŚCICIELEM jest moduł `social`: tematy wydobywa ten sam konsument, który
// buduje oś aktywności (`onSocialPostPublished` / `onPostPublished`), więc
// projekcja tematów powstaje dokładnie tam, gdzie projekcja feedu.
//
// ADR-010: strona tematu jest CHRONOLOGICZNA. Liczba użyć służy wyłącznie do
// podpowiedzi nawigacyjnych, nigdy do kolejności treści.
// ---------------------------------------------------------------------------

model Topic {
  id        String   @id @default(cuid())
  // Pisownia z pierwszego użycia — pokazujemy ją, żeby „#AI" nie stało się „#ai".
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  socialPosts SocialPostTopic[]
  posts       PostTopic[]

  @@map("topics")
}

model SocialPostTopic {
  postId  String
  topicId String

  post  SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  topic Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([postId, topicId])
  @@index([topicId])
  @@map("social_post_topics")
}

model PostTopic {
  postId  String
  topicId String

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([postId, topicId])
  @@index([topicId])
  @@map("post_topics")
}

// ---------------------------------------------------------------------------
// social — wpis portalowy (X-lite, S8)
//
// Świadomie OSOBNE encje, a nie rozluźnienie Post.groupId do nullable:
// groups.addComment/react/getPost bezwarunkowo wołają requireActiveMembership,
// więc dorabianie tam gałęzi „a jak nie ma grupy" oznaczałoby modyfikowanie
// działającego kodu kontroli dostępu — najgorszy możliwy stosunek ryzyka do
// zysku. To zresztą różne byty: wpis w grupie ma tytuł, typ i moderację
// grupową; wpis portalowy to krótka notka do obserwujących.
//
// ANTY-MLM: żadna z tych encji nie rodzi PointEvent. Zdarzenia social.* nie są
// subskrybowane przez ladder (test strukturalny w modules/social).
// ---------------------------------------------------------------------------

model SocialPost {
  id           String    @id @default(cuid())
  authorUserId String
  body         String    @db.Text
  // Cytowany wpis („podaj dalej z komentarzem"). NULL = zwykły wpis.
  // Świadomie BEZ kaskady: usunięcie cytowanego wpisu nie może skasować cudzej
  // wypowiedzi, która go komentuje — pokazujemy wtedy „wpis niedostępny".
  quotedPostId String?
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  author     User              @relation("SocialAuthor", fields: [authorUserId], references: [id])
  comments   SocialComment[]
  reactions  SocialReaction[]
  images     SocialPostImage[]
  topics     SocialPostTopic[]
  quotedPost SocialPost?       @relation("SocialQuote", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotedBy   SocialPost[]      @relation("SocialQuote")

  @@index([authorUserId, createdAt])
  @@index([createdAt])
  @@index([quotedPostId])
  @@fulltext([body])
  @@map("social_posts")
}

// Obrazy przy wpisie portalowym (do 4, jak w X). Wzorzec ListingImage.
model SocialPostImage {
  id       String @id @default(cuid())
  postId   String
  fileId   String
  position Int    @default(0)

  post SocialPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  file UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([postId, fileId])
  @@index([postId, position])
  @@map("social_post_images")
}

model SocialComment {
  id           String    @id @default(cuid())
  postId       String
  authorUserId String
  // Wątkowanie 1 poziom, jak w grupach (ADR-010).
  parentId     String?
  body         String    @db.Text
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  post    SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User            @relation("SocialCommentAuthor", fields: [authorUserId], references: [id])
  parent  SocialComment?  @relation("socialCommentThread", fields: [parentId], references: [id])
  replies SocialComment[] @relation("socialCommentThread")

  @@index([postId, createdAt])
  @@map("social_comments")
}

// Jedna reakcja „doceniam" — jak w grupach, bez palety emocji i BEZ punktów.
model SocialReaction {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation("SocialReactor", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("social_posts_reactions")
}

// ---------------------------------------------------------------------------
// Zakładki (S17) — PRYWATNE zapisywanie treści na później.
//
// ADR-010: zakładka nie ma i NIE BĘDZIE mieć publicznego licznika. Widzi ją
// wyłącznie jej właściciel; nigdzie nie zwracamy „ile osób zapisało". To nie
// przeoczenie — licznik zamieniłby prywatną półkę w kolejną walutę popularności
// obok „doceniam", a Portal ma jedną walutę i jest nią zapracowany status.
//
// ANTY-MLM: zapisanie do zakładek nie emituje ŻADNEGO zdarzenia do outboxa —
// tak samo jak `identity.updateOnboarding`. Brak zdarzenia to brak drogi do
// laddera, czyli zabezpieczenie z architektury, a nie z regulaminu.
//
// WŁAŚCICIELEM jest moduł `social` — ten sam, który trzyma tematy nad OBIEMA
// tabelami treści. Zakładka, jak temat, jest projekcją nad wpisem portalowym
// i postem w grupie naraz.
// ---------------------------------------------------------------------------

enum BookmarkSubjectType {
  SOCIAL_POST
  POST
}

model Bookmark {
  userId String
  // Polimorf BEZ klucza obcego na treść — dwa różne rodzaje treści nie zmieszczą
  // się w jednym FK. Wiersz po skasowanej treści zostaje wiszący, ale odczyt
  // filtruje treść usuniętą i ukrytą, więc jest niewidoczny i tani. Świadomy
  // wybór: alternatywą były dwie bliźniacze tabele albo kaskada z każdej strony.
  subjectType BookmarkSubjectType
  subjectId   String
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Klucz złożony daje idempotencję za darmo — powtórne zapisanie tej samej
  // treści nie mnoży wierszy (ten sam wzorzec co SocialReaction).
  @@id([userId, subjectType, subjectId])
  // Lista „Zapisane" jest chronologiczna po czasie ZAPISANIA, nie publikacji.
  @@index([userId, createdAt])
  @@map("bookmarks")
}
