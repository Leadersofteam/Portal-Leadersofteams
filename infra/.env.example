# Kopiowane na VPS jako /opt/portal/.env (chmod 600, właściciel: deploy).
# NIGDY nie commitować wypełnionego pliku.

# Obrazy (ustawiane przez CI; puste = build lokalny na VPS, wariant 0 zł)
WEB_IMAGE=ghcr.io/leadersofteam/portal-web:v0.1.0
API_IMAGE=ghcr.io/leadersofteam/portal-api:v0.1.0

# MySQL
MYSQL_ROOT_PASSWORD=zmien-mnie
MYSQL_PASSWORD=zmien-mnie

# Publiczny adres frontendu (linki w e-mailach).
APP_BASE_URL=https://leadersofteams.pl

# E-mail (D4) — OPCJONALNE. Puste = brak wysyłki (0 zł, ADR-009). Podanie klucza
# Brevo (darmowy tier 300/dzień) włącza weryfikację adresu, reset hasła i digest.
BREVO_API_KEY=
MAIL_FROM=no-reply@leadersofteams.pl
MAIL_FROM_NAME=Leaders of Teams

# Antybot Cloudflare Turnstile (D7) — OPCJONALNE. Puste = ochrona OFF (0 zł, domyślnie
# otwarte). Aby WŁĄCZYĆ przy launchu: załóż darmowy widget Turnstile i podaj OBIE wartości.
#  - TURNSTILE_SECRET_KEY: sekret serwerowy (backend weryfikuje token przy /auth/register).
#  - NEXT_PUBLIC_TURNSTILE_SITE_KEY: klucz publiczny (front renderuje widget) — musi być
#    ustawiony w BUILD-time obrazu web (NEXT_PUBLIC_* zapiekane w buildzie).
# Klucze testowe Cloudflare (zawsze-przechodzą, do smoke): site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Staging (tylko /opt/portal-staging/.env): wynik `htpasswd -nB uzytkownik`
# STAGING_BASIC_AUTH=uzytkownik:$2y$05$...
