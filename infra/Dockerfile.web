# Frontend Next.js (output: standalone). Budowany z korzenia repo:
# docker build -f infra/Dockerfile.web .

FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter @lot/web...
# Cel rewrite'u /api/* w next.config jest ZAPIEKANY w build-time (routes-manifest.json),
# a nie czytany z env w runtime. W obrazie (compose) api jest zawsze pod http://api:3001,
# więc pieczemy tę wartość tu. Dev (pnpm dev poza Dockerem) używa fallbacku localhost:3001.
ENV API_INTERNAL_URL=http://api:3001
# Site-key Turnstile (D7) MUSI wejść tutaj, w BUILD-time. `NEXT_PUBLIC_*` jest
# zapiekane w bundlu klienta, więc dopisanie klucza do .env i restart kontenera
# NIE WŁĄCZY widgetu — potrzebny jest rebuild obrazu web. Do S12 tego przelotu
# w ogóle nie było: backend Turnstile był gotowy, a klucz publiczny nie miał
# jak dotrzeć do frontu. Puste = widget się nie renderuje (ochrona OFF).
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY}
RUN pnpm --filter @lot/web build

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
