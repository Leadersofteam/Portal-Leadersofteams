# Frontend Next.js (output: standalone). Budowany z korzenia repo:
# docker build -f infra/Dockerfile.web .

FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter @lot/web...
# Cel rewrite'u /api/* w next.config jest ZAPIEKANY w build-time (routes-manifest.json),
# a nie czytany z env w runtime — dlatego to ARG, nie tylko zmienna uruchomieniowa.
#
# ⚠️ DLACZEGO TO JEST PARAMETR, A NIE STAŁA „http://api:3001":
# na tym VPS staging i produkcja dzielą sieć Traefika (`n8n_default`), a compose
# nadaje każdej usłudze alias równy jej nazwie. Nazwa `api` istniała więc W OBU
# projektach naraz i kontener `portal-staging-web` rozwiązywał ją na API
# PRODUKCYJNE — staging po cichu pokazywał dane produkcji. Staging przekazuje
# tu jednoznaczny alias (`api-staging`), produkcja zostaje przy `api`.
ARG API_INTERNAL_URL=http://api:3001
ENV API_INTERNAL_URL=${API_INTERNAL_URL}
# Bramka anty-bot NIE potrzebuje tu żadnego klucza: po wykluczeniu Cloudflare
# liczy się w całości u nas (patrz apps/api/src/shared/humancheck.ts). Zniknął
# przez to cały problem `NEXT_PUBLIC_*` zapiekanego w buildzie — włączenie
# ochrony nie wymaga ani rebuildu obrazu, ani niczyich sekretów.
RUN pnpm --filter @lot/web build

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
